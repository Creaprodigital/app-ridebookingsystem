{
  "expo": {
    "name": "RideBookingSystem",
    "slug": "shared-ride-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sharedridedriver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Share your position to receive nearby rides",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Track your trips and receive nearby ride requests",
        "NSLocationAlwaysUsageDescription": "Share your position while driving in background",
        "NSCameraUsageDescription": "Scan documents and attach ride photos",
        "NSMicrophoneUsageDescription": "Record voice notes during a ride",
        "NSContactsUsageDescription": "Call riders directly from your contact list",
        "NSPhotoLibraryUsageDescription": "Attach photos from your gallery to a ride",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ]
      },
      "bundleIdentifier": "app.emergent.rideshareapp1712dcad343"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#071731"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "CALL_PHONE",
        "VIBRATE",
        "SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.sharedridedriver"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-horizontal-dark.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#071731"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Partagez votre position pour recevoir et suivre les courses, même en arrière-plan.",
          "locationWhenInUsePermission": "Partagez votre position pour recevoir des courses à proximité.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0B63F6",
          "sounds": []
        }
      ],
      "./plugins/with-incoming-ride-notifications",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "20c0bc93-592a-440a-8911-c37540761309"
      }
    }
  }
}
